# Free key: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Off | LowConfidence | Always
LLM_MODE=Off
# From inside Docker, a local Ollama is reachable at host.docker.internal
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1:8b
# Host port for the UI (change if 8080 is taken)
WEB_PORT=8080
# Key for /admin/feedback and GET /api/admin/feedback/summary. Empty = admin disabled.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=
# Secret for hashing visitor IPs in tag reports (abuse control). Empty = random per restart.
FEEDBACK_SALT=
# Email alerts. Links in emails point here (use your WEB_PORT, e.g. http://localhost:8081).
PUBLIC_BASE_URL=http://localhost:8080
ALERTS_TIME_ZONE=America/New_York
# Smtp sends to the local MailPit inbox (http://localhost:8025). Ses needs a verified domain
# (SPF, DKIM, DMARC), SES production access, and AWS credentials in the environment.
EMAIL_PROVIDER=Smtp
EMAIL_FROM=FedTech Search <alerts@localhost>
AWS_REGION=us-east-1
